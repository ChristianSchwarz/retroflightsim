{
  "$schema": "Canonical Tiny Combat Arena naming conventions for tools/import_mod.py. See docs/tca-aircraft-mods.md.",
  "sharedMaterials": {
    "Canopy": { "paletteCategory": "GLASS" },
    "Glass": { "paletteCategory": "GLASS" },
    "Glass HUD": { "paletteCategory": "GLASS" },
    "CanopyGlass": { "paletteCategory": "GLASS" },
    "Windscreen": { "paletteCategory": "GLASS" },
    "CanopyBack": { "paletteCategory": "GLASS" },
    "ColliderMat": { "action": "skip" },
    "Collider": { "action": "skip" },
    "ShadowDepthOffset": { "action": "skip" },
    "ShadowHeightOffset": { "action": "skip" },
    "Shadow": { "action": "skip" },
    "NozzleInteriorMat": { "paletteCategory": "FX_FIRE" },
    "NozzleInterior": { "paletteCategory": "FX_FIRE" }
  },
  "partCategories": {
    "glass": {
      "exact": ["Canopy"],
      "substring": [
        "CanopyGlass",
        "CanopyFront",
        "CanopyBack",
        "CanopySide",
        "Windscreen",
        "CanopyEject"
      ],
      "excludeSubstring": ["CanopyFrame", "CanopyRubber", "CanopySeal", "CanopyRail"]
    },
    "nozzle": {
      "exact": ["Nozzle"],
      "substring": [
        "NozzleInterior",
        "NozzleInner",
        "NozzleInt",
        "NozzleInside",
        "NozzleIn",
        "NozzleL",
        "NozzleR",
        "NozzleLeft",
        "NozzleRight",
        "Nozzle1",
        "Nozzle2",
        "AfterburnerInterior",
        "AfterburnerInner",
        "BurnerInterior",
        "BurnerInner",
        "ABInterior",
        "ABInner"
      ]
    },
    "engine": {
      "substring": [
        "Engine",
        "Nozzle",
        "Exhaust",
        "Burner",
        "Jetpipe",
        "Tailpipe",
        "Afterburner",
        "TailInner"
      ],
      "excludeSubstring": ["Tail"]
    },
    "skip": {
      "substring": ["Collider", "Shadow", "WingInner"]
    },
    "discoverSkip": {
      "substring": [
        "Collider",
        "Shadow",
        "Stick",
        "Gauge",
        "Needle",
        "Pylon",
        "Weapon",
        "Cockpit",
        "Seat",
        "Mirror",
        "Empty",
        "FX",
        "Light",
        "Bolt",
        "AIM",
        "Gun",
        "Tank",
        "Launcher"
      ]
    },
    "importClutterSkip": {
      "substring": [
        "Stick",
        "Gauge",
        "Needle",
        "Pylon",
        "Weapon",
        "Mirror",
        "FX",
        "Light",
        "Bolt",
        "AIM",
        "Gun",
        "Tank",
        "Launcher",
        "Missile",
        "Bomb",
        "Rocket",
        "Pod"
      ]
    },
    "cockpit": {
      "substring": [
        "Cockpit",
        "CockpitInterior",
        "Instrument",
        "Instruments",
        "Console",
        "Dashboard",
        "HUDMount"
      ],
      "excludeSubstring": ["Canopy"]
    },
    "attachmentEmpty": {
      "substring": [
        "Pylon",
        "Hardpoint",
        "Loadout",
        "WeaponPoint",
        "WeaponMount",
        "WeaponStation",
        "Station",
        "Rack",
        "Pilot",
        "CockpitCam",
        "Camera",
        "WingTrail",
        "EngineFX",
        "EngineEffect",
        "Trail"
      ],
      "exact": ["Empty"]
    },
    "bodyHint": {
      "substring": [
        "Fuselage",
        "Wing",
        "Nose",
        "Elevator",
        "Rudder",
        "Aileron",
        "Tail",
        "Fin",
        "Stabilizer",
        "Slat",
        "Flap",
        "Intake",
        "Nozzle",
        "SpeedBrake",
        "Body",
        "Hull"
      ]
    },
    "wingtip": {
      "exact": ["WingTip", "Wingtip", "Tip"],
      "substring": ["WingTip", "Wingtip"]
    },
    "fuselage": {
      "substring": ["Fuselage"],
      "exact": ["Body", "Hull", "Fuse"]
    },
    "gear": {
      "exact": [
        "GearNoseWheel",
        "GearMainWheelL",
        "GearMainWheelR",
        "GearNoseStrut",
        "GearMainStrutL",
        "GearMainStrutR",
        "GearNoseBase",
        "GearNoseBase2",
        "GearMainBaseL",
        "GearMainBaseR",
        "GearDoorFront",
        "GearDoorL",
        "GearDoorR",
        "GearNoseDoor",
        "GearLSupport1",
        "GearLSupport2",
        "GearRSupport1",
        "GearRSupport2",
        "GearNoseSupport",
        "GearNoseSupporter1",
        "GearNoseSupporter2",
        "GearDoorFront1",
        "GearDoorFront2",
        "GearDoorFrontL",
        "GearDoorFrontR",
        "GearDoorL1",
        "GearDoorL2",
        "GearDoorR1",
        "GearDoorR2",
        "GearDoorLE",
        "GearDoorRE",
        "GearDoorNoseL",
        "GearDoorNoseR",
        "GearNoseDoor1",
        "GearNoseDoorL",
        "GearNoseDoorR",
        "GearNoseDoorL1",
        "GearNoseDoorL2",
        "GearNoseDoorR1",
        "GearNoseDoorR2",
        "DoorEmpty1",
        "FuselageDoor1",
        "WLDoor1",
        "WLDoor2",
        "WRDoor1",
        "WRDoor2",
        "WingLDoor1",
        "WingLDoor2",
        "WingRDoor1",
        "WingRDoor2"
      ],
      "prefix": [
        "WLDoor",
        "WRDoor",
        "DoorEmpty",
        "WingLDoor",
        "WingRDoor",
        "BGearDoor",
        "BGearNoseDoor"
      ],
      "substringAll": [
        ["door", "gear"],
        ["geardoor"]
      ],
      "clipSkip": {
        "exact": ["GearHandle", "GearLever", "GearLever1", "GearLever2"],
        "substring": ["navlight"]
      },
      "mandatoryBones": [
        "GearNoseBase",
        "GearMainBaseL",
        "GearMainBaseR"
      ]
    }
  },
